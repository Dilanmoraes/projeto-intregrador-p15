# [Célula 1] Importações
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sqlalchemy import create_engine
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report, accuracy_score, f1_score

# [Célula 2] Conexão e Carga de Dados do PostgreSQL
DATABASE_URL = "postgresql://postgres:senha@localhost:5432/projeto_p15"
engine = create_engine(DATABASE_URL)

query = """
SELECT v.id_venda, v.id_cliente, v.data_venda, v.valor_total, v.quantidade_itens, 
       c.cidade, c.estado, c.data_cadastro
FROM vendas v
JOIN clientes c ON v.id_cliente = c.id_cliente;
"""
df = pd.read_sql(query, con=engine)

# [Célula 3] Engenharia de Features
data_ref = df['data_venda'].max()
features = df.groupby('id_cliente').agg(
    recencia_dias=('data_venda', lambda x: (data_ref - x.max()).days),
    frequencia_total=('id_venda', 'count'),
    valor_monetario_total=('valor_total', 'sum'),
    ticket_medio=('valor_total', 'mean')
).reset_index()

features['churn_target'] = (features['recencia_dias'] > 90).astype(int)

# [Célula 4] Modelagem e Avaliação
X = features[['recencia_dias', 'frequencia_total', 'valor_monetario_total', 'ticket_medio']]
y = features['churn_target']

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)
model = RandomForestClassifier(random_state=42)
model.fit(X_train, y_train)

y_pred = model.predict(X_test)
print(f"Accuracy: {accuracy_score(y_test, y_pred):.4f}")
print(f"F1-Score: {f1_score(y_test, y_pred):.4f}")
print(classification_report(y_test, y_pred))